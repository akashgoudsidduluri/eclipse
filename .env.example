# Eclipse model providers (PR #7). Copy to .env and fill in your own keys:
#   cp .env.example .env
# NEVER commit a real .env — it is gitignored. Every value below is a
# placeholder. The server loads .env at startup (server/main.py); real
# environment variables win over .env values.
#
# Chain order (local-first default): Ollama -> Antseed -> Groq.
# Override the order with ECLIPSE_PROVIDER_ORDER, e.g.:
#   ECLIPSE_PROVIDER_ORDER=groq,ollama,antseed
# Providers not listed keep their default relative order.

# Ollama (local, no key needed — must be running on this machine)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# Antseed gateway. ANTSEED_BASE_URL defaults to Akash's gateway
# (https://akash-antseed.duckdns.org/v1) — if you run your own
# gateway, point ANTSEED_BASE_URL at it instead.
# ANTSEED_API_KEY=your-antseed-key-here
# ANTSEED_BASE_URL=https://akash-antseed.duckdns.org/v1
# ANTSEED_MODEL=google-gemma-4-31b-it

# Groq (cloud fallback)
# GROQ_API_KEY=your-groq-key-here
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=gpt-oss-120b
