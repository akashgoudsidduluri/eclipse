# Eclipse local-only files — never committed
# PR #7: model keys live in .env (see .env.example for the
# placeholder template, which IS committed). A real .env must
# never reach the repo.
.env
data/*
!data/.gitkeep
.venv/
__pycache__/
*.pyc
*.pyo
evals/sih-benchmark/results/
*.egg-info/
.DS_Store
# Extension: downloaded models and build output (see models/README.md)
extension/models/*
!extension/models/README.md
# Server: downloaded embeddings model (~91 MB, binary — never pushed;
# download with scripts/download_rag_model.py or see server/rag/README)
server/rag/models/*
!server/rag/models/README.md
extension/node_modules/
extension/dist/
extension/tests-dist/
# Workspace: dependencies (install with `npm install` in web/workspace)
web/workspace/node_modules/
web/workspace/tests-dist/
# Binary files — the snapshot push is UTF-8 text only, so these
# stay local: fixture PNGs (regenerate after cloning with
# evals/sih-benchmark/fixtures/generate_images.py), the screenshot
# review PNGs, and the TBP report PDF (download it from the VM).
*.png
*.pdf
# Exception (PR #5, W3): the extension's notification icon is a
# shipped asset — chrome.notifications needs a packaged PNG at
# icons/eclipse-128.png. NOTE: the snapshot push is UTF-8 text
# only, so the coordinator must confirm this one binary file
# survives the push (or push it via git CLI).
!extension/icons/eclipse-128.png
